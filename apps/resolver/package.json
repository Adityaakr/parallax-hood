{
  "name": "@parallax-hood/resolver",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fork": "RESOLVER_FORK_TEST=1 vitest run test/fork.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@parallax-hood/sdk": "workspace:*",
    "@parallax-hood/uniswap-client": "workspace:*",
    "hono": "^4.6.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts"
}
