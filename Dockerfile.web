# The Next.js app. Separate from the service image because the web build needs devDependencies and the whole
# app directory, while the resolver/MCP/monitor image deliberately excludes them.
FROM node:22-slim
RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
WORKDIR /app

# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so they have to be present here and
# not only at runtime. Railway passes a service's variables to the build; these ARGs are what receive them.
ARG NEXT_PUBLIC_RESOLVER_URLS
ARG NEXT_PUBLIC_RESOLVER_URL
ARG NEXT_PUBLIC_DEFAULT_CHAIN=46630
ARG NEXT_PUBLIC_PRIVY_APP_ID
ENV NEXT_PUBLIC_RESOLVER_URLS=$NEXT_PUBLIC_RESOLVER_URLS \
    NEXT_PUBLIC_RESOLVER_URL=$NEXT_PUBLIC_RESOLVER_URL \
    NEXT_PUBLIC_DEFAULT_CHAIN=$NEXT_PUBLIC_DEFAULT_CHAIN \
    NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter '@parallax-hood/web...'
# the SDK is transpiled into the app, so it is built first; its ABI generator keeps the committed abis.ts
# when contracts/out is absent, which it is in any build from the repository
RUN pnpm --filter @parallax-hood/sdk build && pnpm --filter @parallax-hood/web build

ENV NODE_ENV=production PORT=3200
EXPOSE 3200
# Railway assigns the port, so it is read at start rather than baked into the script
CMD ["sh", "-c", "pnpm --filter @parallax-hood/web exec next start -p ${PORT:-3200}"]
