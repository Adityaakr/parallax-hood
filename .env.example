# Binance Web3 API (https://web3.binance.com/en/dev-portal/project)
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Set to "fixtures" to replay recorded responses from ./fixtures (offline demo / tests)
BINANCE_CLIENT_MODE=live

# RPC
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# Local fork: anvil --fork-url $BSC_RPC_URL
FORK_RPC_URL=http://127.0.0.1:8547

# Keys (never commit). Deployer = ADMIN for the hackathon (documented trust assumption).
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Explorer verification
BSCSCAN_API_KEY=

# Resolver storage (SQLite path or Postgres URL)
DATABASE_URL=file:./parallax.db

# Web
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_RESOLVER_URL=http://127.0.0.1:4000
NEXT_PUBLIC_DEFAULT_CHAIN=bsc
