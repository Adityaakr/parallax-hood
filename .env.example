# Copy to .env. Nothing here is required to run locally: `pnpm mocks:up` uses a built-in dev key.

# Which network the resolver, MCP server and monitor act on:
#   4663 Robinhood Chain, 46630 Robinhood Chain Testnet, 31337 local fork of mainnet, 1337 local mocks
CHAIN_ID=1337

# RPC. The public endpoints are the defaults; they are rate-limited and keep about ten minutes of state.
# For a long-lived fork or an indexer backfill use an archive endpoint (the docs recommend Alchemy).
ROBINHOOD_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_FORK_RPC_URL=

# Keys (never commit). Deployer for the testnet and, only after review, mainnet.
DEPLOYER_PRIVATE_KEY=
# The agent key the MCP server signs with. It can only act through AgentMandate; give it gas and nothing else.
AGENT_PRIVATE_KEY=
# Testnet faucet signer for the resolver's /faucet route (mints mock USDG). Never used on mainnet.
FAUCET_PRIVATE_KEY=

# Live market data on the testnet. HYBRID_MARKETS=true reads reference prices, pool depth and multipliers from
# Robinhood Chain mainnet while execution stays on the testnet. MIRROR_PRIVATE_KEY (the testnet deployer: owner
# of the test venue and tokens, keeper of the registry) lets the resolver copy mainnet's pool prices, Chainlink
# references and multipliers onto the test contracts. `pnpm testnet:dev` sets both. Refused on mainnet.
HYBRID_MARKETS=
MIRROR_PRIVATE_KEY=
# Robinhood's read-only Stock Token API (issuer quotes, sessions, corporate actions). Empty value turns it off.
ROBINHOOD_API_URL=https://api.robinhood.com/rhj

# Deployment
FEE_BPS=50
FEE_RECIPIENT=
# Most units a vault may have outstanding, in whole units (about 100 dollars each). 0 = uncapped.
SUPPLY_CAP_UNITS=

# Resolver storage (SQLite path). Default: ./parallax-<chainId>.db
DATABASE_URL=

# Web
NEXT_PUBLIC_RESOLVER_URL=http://127.0.0.1:4100
NEXT_PUBLIC_DEFAULT_CHAIN=1337
NEXT_PUBLIC_PRIVY_APP_ID=
