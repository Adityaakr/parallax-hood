{
  "name": "parallax-hood",
  "private": true,
  "version": "0.1.0",
  "description": "Parallax on Robinhood Chain: share-denominated routing, USDG-settled index vaults and onchain agent mandates for tokenized stocks.",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "contracts:test": "cd contracts && forge test",
    "contracts:build": "cd contracts && forge build",
    "contracts:fork-test": "./scripts/fork-test.sh",
    "universe": "pnpm --filter @parallax-hood/scripts gen-universe",
    "mocks:up": "./scripts/mocks-up.sh",
    "fork:up": "./scripts/fork-up.sh",
    "testnet:up": "./scripts/testnet-up.sh",
    "monitor": "pnpm --filter @parallax-hood/monitor once",
    "docker:build": "docker build -t parallax-hood ."
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  }
}
